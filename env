################################################
# Env Variables configurations                 #
################################################

# Save
platform=$(uname)

# Default editor; set EDITOR in ~/.local_shellrc to use something else (e.g. nvim) on a machine.
# VISUAL is set to match after ~/.local_shellrc loads (see zshrc / bashrc).
export EDITOR='vim'
export PAGER='less'

if [[ $platform == 'Darwin' ]]; then
  export BROWSER='open'
fi

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

################################################
# Path configurations                          #
################################################
export GOPATH="$HOME/.go"
export PATH="$PATH:$GOPATH/bin"

export PATH="$PATH:$HOME/.dotfiles/bin"

if [[ $platform == 'Darwin' ]]; then
    export HOMEBREW_CASK_OPTS="--appdir=/Application"
    export PATH="$HOME/anaconda2/bin:$PATH"
fi

export VIRTUAL_ENV_DISABLE_PROMPT=1

export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
