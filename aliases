################################################
# HTTP                                         #
################################################

# http-<method> <url> [json-body]; json-<method> pipes the response through jq
_http() {
    local method=$1 url=$2 body=$3
    if [ -n "$body" ]; then
        curl -s -X "$method" -H "Content-Type: application/json" -d "$body" "$url"
    else
        curl -s -X "$method" "$url"
    fi
}
http-get()    { _http GET    "$@"; }
http-post()   { _http POST   "$@"; }
http-put()    { _http PUT    "$@"; }
http-patch()  { _http PATCH  "$@"; }
http-delete() { _http DELETE "$@"; }
json-get()    { http-get    "$@" | jq; }
json-post()   { http-post   "$@" | jq; }
json-put()    { http-put    "$@" | jq; }
json-patch()  { http-patch  "$@" | jq; }
json-delete() { http-delete "$@" | jq; }

################################################
# Python & dev servers                         #
################################################

# python venv helper: toggles a venv (default dir "venv"), creating it if needed
venv() {
    if [ -n "${VIRTUAL_ENV+set}" ]; then
        echo "Deactivating virtual env..."
        deactivate
        return
    fi

    local V_DIR="${1:-venv}"
    if [ ! -d "$V_DIR" ]; then
        echo "Creating virtual env in \"$V_DIR\"..."
        python3 -m venv "$V_DIR" || return
    fi

    echo "Activating virtual env..."
    source "$V_DIR/bin/activate"
}
alias venv3=venv

function python-server {
    python3 -m http.server "${1:-8000}"
}

function php-server {
    php -S localhost:8000 -t .
}

################################################
# fzf (zsh only: bash stays a plain fallback)  #
################################################

if [ -n "${ZSH_NAME+set}" ]; then
    # Prompt at the top for every fzf, a single line beside the preview,
    # and ctrl+o to open the selected file in vim
    export FZF_DEFAULT_OPTS="--layout=reverse --preview-window=border-left --bind='ctrl-o:execute(\$EDITOR {})+abort'"
    export FZF_DEFAULT_COMMAND='rg --files'

    # fzf file preview: bat, or batcat (Debian/Ubuntu's name for it), or plain cat
    if command -v bat > /dev/null; then
        _fzf_preview='bat --style numbers --color always {}'
    elif command -v batcat > /dev/null; then
        _fzf_preview='batcat --style numbers --color always {}'
    else
        _fzf_preview='cat {}'
    fi
    alias f='fzf --preview "$_fzf_preview"'

    # Ctrl-T: list files with rg (like plain fzf) instead of find, and preview them
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_CTRL_T_OPTS="--preview '$_fzf_preview'"

    # Open a file picked by name
    vimf() {
        file=$(fzf --height 40% --preview "$_fzf_preview")

        if [ ! -z "$file" ]; then
            $EDITOR $file
        fi
    }
    alias vf=vimf

    # Open a file picked from the ones whose contents match
    vimr() {
        local search file
        if [ $# -eq 0 ]; then
            read search
        else
            search=$1
        fi

        rg "$search"
        file=$(rg -l "$search" | fzf --height=40% --preview "$_fzf_preview")

        if [ -n "$file" ]; then
            $EDITOR "$file"
        fi
    }
    alias vr=vimr

    # Pick a directory you've been to (from z, most used first) with fzf. `zi foo` starts the search with foo.
    zi() {
        local dir
        dir=$(_z -l 2>&1 | sort -rn | awk '{ $1 = ""; sub(/^ +/, ""); print }' |
            fzf --height 40% --layout=reverse --no-sort --query "$*" --preview 'ls -A {}') && cd "$dir"
    }

    fzf-git-branch() {
        git rev-parse HEAD > /dev/null 2>&1 || return

        # Build the full list before fzf opens, so enter acts on a complete,
        # correctly ordered list instead of whatever has streamed in so far
        local branches
        branches=$(git-branches-sorted) || return

        print -r -- "$branches" |
            fzf --height 50% --ansi --no-multi --no-sort --print-query --preview-window right:65% \
                --preview 'git-log-remote-or-not {}'
    }

    fzf-git-checkout() {
        git rev-parse HEAD > /dev/null 2>&1 || return

        if [ -n "$1" ]; then
            git checkout "$1" 2>/dev/null || git checkout -b "$1"
        else
            local branch
            branch=($(fzf-git-branch))

            if [[ "$branch[1]" = "" ]]; then
                echo "No branch selected."
                return
            fi

            if [[ "$branch[2]" = "" ]]; then
                git checkout "$branch[1]" 2>/dev/null || git checkout -b "$branch[1]"
                return
            fi

            git checkout $branch[2]
        fi
    }

    alias gc="fzf-git-checkout"
fi
