alias tls="tmux ls"
alias tkill="tmux kill-session -t"
tnew() {
    if [ $# -eq 0 ] ; then
        tmux new
    else
        tmux new -s $1
    fi
}

tatt() {
    if [ $# -eq 0 ] ; then
        tmux attach
    else
        tmux attach -t $1 $2
    fi
}
alias t="tnew"

