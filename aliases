alias gpush="git push"
alias gd="git diff"
alias gds="git diff --staged"
alias gnotrack="git update-index --assume-unchanged"
alias gtrack="git update-index --no-assume-unchanged"
alias grekt="git reset --hard HEAD"

# Default branch of origin (main/master/...), from the local remote HEAD
git-default-branch() {
    local ref
    if ref=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
        echo "${ref#origin/}"
    else
        git remote show origin | sed -n '/HEAD branch/s/.*: //p'
    fi
}

gpr() {
    local remote branch
    remote=$(git remote get-url origin | sed -E 's~^(git@|https://)[^:/]+[:/]~~; s~\.git$~~')
    branch=$(git rev-parse --abbrev-ref HEAD)
    open "https://github.com/$remote/compare/${1:-$(git-default-branch)}...$branch?expand=1"
}

gcm() {
    git commit -m $1
}

gcom() {
    git commit -am $1
}

