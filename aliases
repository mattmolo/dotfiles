################################################
# Search                                       #
################################################

alias r="rg --no-heading"

# ripgrep-ish search using plain grep, for machines without rg.
# Recursive from ".", line numbers, color, extended regex, skips binary files
# and common junk dirs, smart case (case-insensitive unless the pattern has
# an uppercase letter). Usage: grr [grep options] <pattern> [paths...]
grr() {
    local arg pattern="" case_flag=-i
    for arg in "$@"; do
        case $arg in -*) ;; *) pattern=$arg; break ;; esac
    done
    case $pattern in *[[:upper:]]*) case_flag= ;; esac

    local paths=.
    local nonopt=0
    for arg in "$@"; do
        case $arg in -*) ;; *) nonopt=$((nonopt + 1)) ;; esac
    done
    [ "$nonopt" -gt 1 ] && paths=

    grep -rnIE --color=auto $case_flag \
        --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=venv \
        --exclude-dir=.venv --exclude-dir=__pycache__ --exclude-dir=.mypy_cache \
        --exclude-dir=dist --exclude-dir=build --exclude-dir=target \
        "$@" $paths
}

